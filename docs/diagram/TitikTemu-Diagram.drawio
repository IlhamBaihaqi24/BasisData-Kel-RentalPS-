<mxCell id="c8" value="Aturan:&lt;br&gt;• total = (tarif PS + tarif_tambahan ruangan) x durasi&lt;br&gt;• status sewa (Akan datang / Berlangsung / Selesai) dihitung dari mulai dan durasi, tidak disimpan&lt;br&gt;• PS / ruangan yang sama tidak boleh tumpang tindih waktu&lt;br&gt;• Transfer / QRIS wajib bukti: status Verifikasi, jadi Lunas&lt;br&gt;  setelah admin menyetujui (Tunai: Menunggu, bayar di kasir)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#6B6590;" vertex="1" parent="1"><mxGeometry x="850" y="495" width="390" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Use Case" id="2_Use_Case"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/>
